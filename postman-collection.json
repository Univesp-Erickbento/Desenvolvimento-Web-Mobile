{
  "info": {
    "_postman_id": "catalogo-produtos-api",
    "name": "Catálogo de Produtos API",
    "description": "Coleção de requisições para a API de Catálogo de Produtos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Listar Todos os Produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": ["{{base_url}}"],
          "path": ["api", "products"]
        },
        "description": "Retorna todos os produtos do banco de dados (200 OK)"
      },
      "response": []
    },
    {
      "name": "Buscar Produto por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/:id",
          "host": ["{{base_url}}"],
          "path": ["api", "products", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "COLOQUE_UM_UUID_VALIDO_AQUI"
            }
          ]
        },
        "description": "Retorna um produto específico pelo UUID"
      },
      "response": []
    },
    {
      "name": "Buscar Produto por ID Inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/00000000-0000-0000-0000-000000000000",
          "host": ["{{base_url}}"],
          "path": ["api", "products", "00000000-0000-0000-0000-000000000000"]
        },
        "description": "Testa o cenário de produto não encontrado (404 Not Found)"
      },
      "response": []
    },
    {
      "name": "Criar Novo Produto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Headset Logitech G Pro X\",\n  \"description\": \"Headset gamer wireless com som surround 7.1\",\n  \"price\": 699.90,\n  \"imageUrl\": \"https://placehold.co/600x400\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": ["{{base_url}}"],
          "path": ["api", "products"]
        },
        "description": "Cria um novo produto validado pelo Zod (201 Created)"
      },
      "response": []
    },
    {
      "name": "Criar Produto - Erro de Validação Zod",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"A\",\n  \"description\": \"Curto\",\n  \"price\": -50.00,\n  \"imageUrl\": \"\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": ["{{base_url}}"],
          "path": ["api", "products"]
        },
        "description": "Testa a resposta de erro 400 Bad Request enviando dados inválidos"
      },
      "response": []
    },
    {
      "name": "Atualizar Produto (Parcial)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Notebook Dell Inspiron 15 - Atualizado\",\n  \"price\": 3599.90\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products/:id",
          "host": ["{{base_url}}"],
          "path": ["api", "products", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "COLOQUE_UM_UUID_VALIDO_AQUI"
            }
          ]
        },
        "description": "Atualiza campos de um produto usando o schema parcial (200 OK)"
      },
      "response": []
    },
    {
      "name": "Deletar Produto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/:id",
          "host": ["{{base_url}}"],
          "path": ["api", "products", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "COLOQUE_UM_UUID_VALIDO_AQUI"
            }
          ]
        },
        "description": "Deleta um produto existente pelo UUID (204 No Content)"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string"
    }
  ]
}